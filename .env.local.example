# Mr² Labs Environment Variables Template
# Copy this file to .env.local and fill in your real keys.

# AI Analysis (Groq Llama3)
GROQ_API_KEY=gsk_your_key_here

# Persistence (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Email Sending (Resend / Funnel)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
REPLY_TO_EMAIL=mohrashard@gmail.com

# Funnel Configuration
NEXT_PUBLIC_SITE_URL=https://www.mohamedrashard.dev
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle

# GitHub GitOps Content Engine (Automated Blog Publishing)
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repo_name
GITHUB_PAT=your_personal_access_token
GITHUB_BRANCH=master

# Google Calendar Integration (Booking System & Google Meet)
# NOTE: Set OAuth Consent Screen Publishing Status to 'In production' in Google Cloud Console
# so that the refresh token does not expire after 7 days!
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_CALENDAR_ID=primary
